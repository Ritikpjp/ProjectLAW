# Copy to .env.production on the server and fill in. Never commit it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
APP_URL=https://yourdomain.in
VERIFY_BASE_URL=https://yourdomain.in/v/
# Pre-launch: admins only can log in (code shown in server log). Delete once OTP_PROVIDER=meta works.
ALLOW_CONSOLE_OTP_FOR_ADMINS=true
# OTP_PROVIDER=meta
ADMIN_MOBILES=+91XXXXXXXXXX
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Used by docker compose / Caddy (put in a file named .env next to docker-compose.yml)
# DOMAIN=yourdomain.in
