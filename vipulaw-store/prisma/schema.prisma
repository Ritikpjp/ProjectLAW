generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // switch to "postgresql" + a Postgres DATABASE_URL for production
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  mobile      String    @unique // E.164, e.g. +919876543210 (verified by WhatsApp OTP)
  profession  String
  examTarget  String // Exam.slug
  yearOfStudy String
  role        String    @default("USER") // USER | ADMIN
  createdAt   DateTime  @default(now())
  sessions    Session[]
  orders      Order[]
}

model OtpCode {
  id         String    @id @default(cuid())
  mobile     String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([mobile, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

model Exam {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  blurb     String    @default("")
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  sections  Section[]
  products  Product[]
}

// Optional sub-division of an exam: Paper 1 / Paper 2, Prelims / Mains ...
model Section {
  id        String    @id @default(cuid())
  examId    String
  exam      Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  slug      String
  name      String
  sortOrder Int       @default(0)
  products  Product[]

  @@unique([examId, slug])
}

model Product {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  description  String        @default("")
  examId       String
  exam         Exam          @relation(fields: [examId], references: [id])
  sectionId    String?
  section      Section?      @relation(fields: [sectionId], references: [id])
  // BARE_ACT | PRACTICE_BOOK | PYQ | SYLLABUS | NOTES | MOCK_TEST (reserved for later: no UI yet)
  type         String
  pricePaise   Int
  status       String        @default("DRAFT") // DRAFT | PUBLISHED
  stampProfile String        @default("HEADER") // HEADER | FOOTER
  createdAt    DateTime      @default(now())
  files        ProductFile[]
  orders       Order[]

  @@index([examId, status])
}

model ProductFile {
  id         String     @id @default(cuid())
  productId  String
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  label      String
  sortOrder  Int        @default(0)
  storageKey String // private original
  previewKey String // first pages only (public after purchase page)
  pageCount  Int
  slotsJson  String // per-page QR slot [{x,y,size}|null], computed at upload
  bytes      Int
  downloads  Download[]
}

model Order {
  id                String     @id @default(cuid())
  userId            String
  user              User       @relation(fields: [userId], references: [id])
  productId         String
  product           Product    @relation(fields: [productId], references: [id])
  amountPaise       Int
  status            String     @default("CREATED") // CREATED | PAID | FAILED | REFUNDED
  razorpayOrderId   String     @unique
  razorpayPaymentId String?    @unique
  licenceId         String     @unique
  createdAt         DateTime   @default(now())
  paidAt            DateTime?
  downloads         Download[]

  @@index([userId, status])
}

model Download {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id])
  fileId    String
  file      ProductFile @relation(fields: [fileId], references: [id])
  ipHash    String
  createdAt DateTime    @default(now())

  @@index([orderId, fileId])
}

model WebhookEvent {
  id        String   @id // Razorpay event id, for idempotency
  createdAt DateTime @default(now())
}
